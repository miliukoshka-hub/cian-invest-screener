{
  "manifest_version": 3,
  "name": "ЦИАН → Инвест-скринер",
  "description": "Передаёт видимые карточки текущей выдачи ЦИАН в локальный инвестиционный скринер.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["https://www.cian.ru/*", "https://cian.ru/*", "http://localhost:3456/*"],
  "action": { "default_popup": "popup.html", "default_title": "Собрать текущую выдачу ЦИАН" }
}
